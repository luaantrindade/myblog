{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "deployCommitMessage",
      "type": "promptString",
      "description": "Commit message for this deployment",
      "default": "Deploy website"
    }
  ],
  "tasks": [
    {
      "label": "Deploy to Hostinger",
      "type": "process",
      "command": "bash",
      "args": [
        "${workspaceFolder}/scripts/deploy-to-hostinger.sh",
        "${input:deployCommitMessage}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
